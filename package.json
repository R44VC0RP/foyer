{
  "name": "foyer",
  "private": true,
  "version": "0.2.0",
  "description": "Chrome extension that connects any password manager (fill, save, passkeys, Sign in with Google) and learns how every site signs you in.",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "watch": "bun scripts/build.ts --watch",
    "typecheck": "tsc --noEmit",
    "bridge:install": "bun bridge/install.ts",
    "bridge:uninstall": "bun bridge/install.ts --uninstall"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/chrome": "^0.3.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "tldts": "^7.4.18"
  }
}
