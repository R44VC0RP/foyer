{
  "manifest_version": 3,
  "name": "Foyer",
  "short_name": "Foyer",
  "version": "0.2.0",
  "key": "",
  "description": "Connect any password manager. Fill and save logins, passkeys and Sign in with Google, and learn how every site signs you in.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "webNavigation",
    "alarms",
    "activeTab",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "passkey-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Foyer: logins for this site",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "incognito": "not_allowed",
  "web_accessible_resources": [
    {
      "resources": [
        "menu.html",
        "menu.css",
        "menu.js",
        "dialog.html",
        "dialog.css",
        "dialog.js",
        "theme.css",
        "fonts/Geist-Variable.woff2",
        "fonts/GeistMono-Variable.woff2",
        "icons/icon-48.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "commands": {
    "fill-login": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill a login on this page"
    }
  }
}
